{
    /*----General----*/
    "height": 0,
    "spacing": 0,
    "layer": "top",
    //  "margin-top": 4,
    //	"margin-left": 4,
    //	"margin-right": 4,
    //	"margin-bottom": 0,

    "include": [
        "~/.config/waybar/modules/custom/dividers.jsonc",
        "~/.config/waybar/modules/clock.jsonc"
    ],

    /*----Layout----*/
    "modules-left": [
        "custom/arch",
        "custom/div#1",
        "niri/workspaces",
        "custom/div#2",
        "custom/gpu",
        "custom/div#3",
        "cpu",
        "temperature",
        "custom/div#4",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/mpris",
        "cava",
        "custom/previous",
        "custom/play",
        "custom/next",
        "custom/div#5",
        "network",
        "custom/connectivity_status",
        "pulseaudio",
        "battery",
        "custom/div#6",
        "group/systray"
    ],

    /*----Arch Menu----*/
    "custom/arch": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/menu.sh"
    },

    /*----Workspaces----*/
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": ""
        },
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    /*----Window----*/
    "niri/window": {
        "format": "{app_id}",
        "on-click": "niri msg action switch-preset-column-width-back",
        "on-click-right": "niri msg action switch-preset-column-width",
        "on-click-middle": "niri msg action close-window",
        "on-scroll-up": "niri msg action focus-column-left",
        "on-scroll-down": "niri msg action focus-column-right",
        "rewrite": {
            "kitty": "Terminal",
            "com.github.th-ch.youtube-music": "YouTube Music",
            "FFPWA-01K86J2FX5J1EEXYCQ272ECWE2": "Whatsapp",
            "org.pulseaudio.pavucontrol": "Volume Control",
            "org.gnome.Nautilus": "Files"
        }
    },

    /*----GPU----*/
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 1,
        "return-type": "json",
        "on-click": "kitty btop &"
    },

    /*----CPU Usage----*/
    "cpu": {
        "interval": 1,
        "on-click": "kitty btop",
        "format": " {usage}%   "
    },

    /*----CPU Temp----*/
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
        "interval": 1,
        "on-click": "kitty btop",
        "format": " {temperatureC}°C"
    },

    /*----Media Player----*/
    // "mpris": {
    //     "interval": 1,
    //     "format": "{player_icon} {title}",
    //     "format-paused": "<i>{player_icon} {title}</i>",
    //     "max-length": 30,
    //     "tooltip-format": "{dynamic}",
    //     "on-click": "swaync-client -t -sw",
    //     "on-scroll-up": "playerctl volume 0.02+",
    //     "on-scroll-down": "playerctl volume 0.02-",
    //     "player-icons": {
    //         "default": "<span foreground='#cba6f7'>󰝚 </span>",
    //         "spotify": "<span foreground='#a6e3a1'>󰓇 </span>",
    //         "firefox": "<span foreground='#f38ba8'>󰗃 </span>",
    //         "YoutubeMusic": "<span foreground='#f38ba8'> </span>"
    //     }
    // },

    "custom/mpris": {
        "exec": "~/.config/waybar/scripts/mpris.sh",
        "interval": 1,
        "return-type": "json",
        "escape": false,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl volume 0.02+",
        "on-scroll-down": "playerctl volume 0.02-"
    },

    "cava": {
        "cava_config": "$HOME/.config/cava/waybar_raw.conf",
        "framerate": 60,
        "autosens": 1,
        //"sensitivity": 100,
        "bars": 6,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "noise_reduction": 0.77,
        "input_delay": 2,
        "sleep_timer": 5,
        "hide_on_silence": true,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "actions": {
            "on-click-right": "mode"
        }
    },

    "custom/play": {
        "exec": "~/.config/waybar/scripts/play_pause.sh",
        "tooltip": false,
        "interval": 1,
        "return-type": "text",
        "signal": 8,
        "on-click": "playerctl play-pause; pkill -RTMIN+8 waybar"
    },

    "custom/previous": {
        "exec": "~/.config/waybar/scripts/previous.sh",
        "tooltip": false,
        "interval": 1,
        "return-type": "text",
        "signal": 8,
        "on-click": "playerctl previous; pkill -RTMIN+8 waybar"
    },

    "custom/next": {
        "exec": "~/.config/waybar/scripts/next.sh",
        "tooltip": false,
        "interval": 1,
        "return-type": "text",
        "signal": 8,
        "on-click": "playerctl next; pkill -RTMIN+8 waybar"
    },

    /*----Wifi----*/
    "network": {
        "interval": 5,
        "format": "󰤨",
        "format-ethernet": "󰈀",
        "format-wifi": "{icon}",
        "format-disconnected": "󰤯",
        "format-disabled": "󰤮",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "~/.config/waybar/scripts/wifi.sh",
        "on-click-middle": "~/.config/waybar/scripts/wifi-toggle.sh",
        "tooltip-format": "Gateway: {gwaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}",
        "tooltip-format-wifi": "Network: {essid}\nIP Addr: {ipaddr}/{cidr}\nStrength: {signalStrength}%\nFrequency: {frequency} GHz",
        "tooltip-format-disconnected": "Wi-Fi Disconnected",
        "tooltip-format-disabled": "Wi-Fi Disabled"
    },

    /*----Connectivity----*/
    "custom/connectivity_status": {
        "exec": "~/.config/waybar/scripts/connectivity.sh",
        "tooltip": false,
        "interval": 5
    },

    /*----Volume----*/
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "{icon}",
        "format-icons": {
            "default": ["", "", ""],
            "default-muted": "",
            "headphone": "󰋋",
            "headphone-muted": "󰟎",
            "headset": "󰋎",
            "headset-muted": "󰋐"
        },
        "on-click": "pavucontrol -t 3",
        "on-click-middle": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume +1",
        "on-scroll-down": "swayosd-client --output-volume -1",
        "tooltip-format": "Volume: {volume}%\n{desc}"
    },

    /*----Battery----*/
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-time": "{H} hr {M} min",
        "format-icons": ["󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "󰂄",
        "tooltip-format": "Battery: {capacity}%\nDischarging: {time}",
        "tooltip-format-charging": "Battery: {capacity}%\nCharging: {time}",
        "on-click": "~/.config/waybar/scripts/power-profile.sh",
        "events": {
            "on-discharging-warning": "notify-send 'Battery Low (30%)' -u critical -i 'battery-020'; powerprofilesctl set power-saver",
            "on-discharging-critical": "notify-send 'Battery Critical (15%)' -u critical -i 'battery-010'"
        }
    },

    /*----Sys Tray Group----*/
    "group/systray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "sys",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/menu",
            "tray",
            "idle_inhibitor",
            "custom/clipboard"
        ]
    },

    /*----Menu/Notifications----*/
    "custom/menu": {
        "format": "", // (nf-fa-reorder)
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
        "on-click-middle": "swaync-client -d -sw"
    },

    /*----App Tray----*/
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    /*----Idle Inhibitor----*/
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        }
    },

    /*----Clipboard----*/
    "custom/clipboard": {
        "format": "",
        "on-click": "vicinae vicinae://launch/clipboard/history",
        "tooltip": false
    }
}
