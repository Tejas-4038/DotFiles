prefer-no-csd

layout {
	gaps 8
	
	default-column-width { proportion 0.667; }
	preset-column-widths {
		proportion 1.0
		proportion 0.33333
		proportion 0.5
		proportion 0.66667
	}
	
	focus-ring { off; }
	
	border {
		on
		width 2
	}
	
	shadow { on; }
}

overview {

}

recent-windows {
	highlight {
        padding 30
        corner-radius 12
    }
}

blur {
    passes 2
    offset 8
}
