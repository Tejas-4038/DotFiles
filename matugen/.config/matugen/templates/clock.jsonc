{
    /*----Clock----*/
    "clock": {
        "format": "{:%a, %b %d <span color='{{colors.outline_variant.default.hex}}' font_family='CaskaydiaCove Nerd Font'>|</span> %I:%M %p}",
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 6,
            "format": {
                "months": "<span color='{{colors.primary.default.hex}}'><b>{}</b></span>",
                "days": "<span color='{{colors.on_surface.default.hex}}'>{}</span>",
                "weekdays": "<span color='{{colors.inverse_primary.default.hex}}'><i>{}</i></span>",
                "today": "<span color='{{colors.tertiary.default.hex}}'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click": "mode"
        }
    }
}
