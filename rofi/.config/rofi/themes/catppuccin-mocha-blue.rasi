/**
 *  Catppuccin Mocha Blue Rofi Theme
 *  Font: CaskaydiaCove Nerd Font
 */

* {
    font: "CaskaydiaCove Nerd Font 12";
    background-color: #1e1e2e;
    text-color: #cdd6f4;
    border-color: #181825;
    selected-normal-foreground: #1e1e2e;
    selected-normal-background: #89b4fa; /* Blue accent */
    selected-active-background: #89b4fa;
    selected-urgent-background: #f38ba8;
    spacing: 6px;
    padding: 8px;
    border-radius: 12px;
}

window {
    transparency: "real";
    background-color: #1e1e2e;
    border: 2px;
    border-color: #89b4fa;
    border-radius: 16px;
    width: 320px;
    location: west;
    anchor: west;
}

mainbox {
    spacing: 8px;
    padding: 16px;
}

inputbar {
    padding: 6px 10px;
    background-color: #181825;
    border-radius: 10px;
}

entry {
    expand: true;
    text-color: #cdd6f4;
    placeholder: "Go...";
    placeholder-color: #6c7086;
}

listview {
    columns: 1;
    lines: 10;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 6px 10px;
    border-radius: 10px;
}

element-icon {
    size: 20px;
    margin: 0 8px 0 0;
}

element-text {
    vertical-align: 0.5;
}

element selected {
    background-color: transparent;
}


element-text selected {
    color: #89b4fa;
}

scrollbar {
    handle-color: #585b70;
    handle-width: 4px;
}

message {
    background-color: #181825;
    border-radius: 8px;
    padding: 10px;
}
