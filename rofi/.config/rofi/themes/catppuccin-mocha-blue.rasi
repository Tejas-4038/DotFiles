@import "colors.rasi"

* {
	font: "Google Sans Flex 11.6";
	background-color: transparent;
	text-color: @on-surface;
	spacing: 6px;
	padding: 8px;
	border-radius: 12px;
}

window {
	transparency: "real";
	background-color: @surface;
	border: 2px;
	border-color: @primary;
	border-radius: 16px;
	width: 480px;
}

mainbox {
	spacing: 8px;
    padding: 16px;
}

inputbar {
	children: [ prompt, entry ];
	padding: 8px 12px;
	background-color: @surface-container-lowest;
	border-radius: 10px;
	margin: 4px 0;
}

entry {
	expand: true;
	text-color: @on-surface;
	placeholder: "Search...";
	placeholder-color: @surface-variant;
}

listview {
	columns: 1;
	scrollbar: false;
	spacing: 6px;
	fixed-height: true;
	lines: 10;
}

element {
	padding: 6px 10px;
	border-radius: 10px;
	orientation: horizontal;
}

element-icon {
	size: 20px;
	margin: 0 8px 0 0;
}

element-text {
	vertical-align: 0.5;
	text-color: @on-surface;
	ellipsize: true;
}

element selected {
	background-color: @primary-selected;
	border: 1px;
	border-color: @primary;
}

element-text selected {
	color: @primary;
}

scrollbar {
	handle-color: #585b70;
	handle-width: 6px;
	border-radius: 3px;
}

message {
	background-color: rgba(24, 24, 37, 0.85);
	border-radius: 8px;
	padding: 10px;
}
